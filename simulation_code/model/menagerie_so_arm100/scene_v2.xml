<mujoco model="scene_menagerie_v2">
    <include file="so_arm101_v2.xml" />

    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
        <rgba haze="0.15 0.25 0.35 1" />
        <global azimuth="160" elevation="-20" />
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512"
            height="3072" />
        <material name="groundplane" rgba="0.025 0.025 0.025 1"
            specular="0" shininess="0" reflectance="0" />
    </asset>

    <worldbody>
        <light pos="0 0 3.5" dir="0 0 -1" directional="true" />
        <geom name="floor" size="0 0 0.05" pos="0 0 0" type="plane" material="groundplane" />

        <!-- Fixed cameras carried over from the legacy so101_new_calib.xml -->
        <camera name="camera_up" pos="0 0.2 0.6" xyaxes="1 0 0 0 1 0" fovy="72" />
        <camera name="camera_side" pos="0.5 0.2 0.25" xyaxes="0 1 0 -0.2873 0 0.9578" fovy="72" />

        <!-- 2in x 2in napkin (place target), matching the physical dataset
             where the cube is always set down on a napkin a few inches away.
             Static thin box; the privileged controller reads its pose. -->
        <geom name="napkin" type="box" pos="0.08 0.30 0.0005" size="0.0254 0.0254 0.0005"
              rgba="0.93 0.91 0.85 1" friction="1 0.005 0.0001" />

        <!-- White block on the ground (half size: 2.5cm cube) -->
        <body name="red_block" pos="0 0.3 0.0125">
            <freejoint/>
            <geom name="red_block_geom" type="box" size="0.0125 0.0125 0.0125" rgba="1 1 1 1" mass="0.05"/>
            <inertial pos="0 0 0" mass="0.05" diaginertia="0.00001 0.00001 0.00001"/>
        </body>
    </worldbody>
</mujoco>
